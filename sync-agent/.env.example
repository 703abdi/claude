# Absolute path to your Obsidian vault (or any folder of markdown notes)
VAULT_PATH="/Users/you/Documents/ObsidianVault"

# Comma-separated folders (relative to VAULT_PATH) to sync. Leave empty to sync everything.
INCLUDE_FOLDERS=""

# Comma-separated folders (relative to VAULT_PATH) to skip. Templates/attachments are good candidates.
EXCLUDE_FOLDERS="Templates,.obsidian,.trash,Attachments"

# Your deployed personal OS URL, no trailing slash
SERVER_URL="https://your-app.vercel.app"

# Must match OBSIDIAN_SYNC_TOKEN in the deployed app's environment variables
SYNC_TOKEN=""

# How often to check for changes and push a batch, in seconds
SYNC_INTERVAL_SECONDS="60"
