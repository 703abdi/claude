# PostgreSQL connection string (Vercel Postgres / Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Single-user login credentials (private app, no signup flow)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# AI (Context Engine extraction, Morning Brief generation, suggestions)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# TTS provider for Morning Brief audio playback. Leave empty to disable audio
# generation — the app falls back to text-only briefs.
# Supported: "openai" | "elevenlabs"
TTS_PROVIDER=""
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""

# Shared secret the local Obsidian sync agent authenticates with.
# Generate with: openssl rand -hex 32
OBSIDIAN_SYNC_TOKEN=""

# Shared secret for the ChatGPT context connector upload endpoint.
CHATGPT_CONNECTOR_TOKEN=""

# Shared secret for the Claude context connector upload endpoint.
CLAUDE_CONNECTOR_TOKEN=""

# Secret for the Vercel Cron-triggered daily refresh (/api/cron/daily-refresh).
# Generate with: openssl rand -hex 32
# Vercel's Hobby plan only supports daily cron granularity, and cron runs on a
# fixed UTC time — adjust the schedule in vercel.json to land near your local
# morning-brief time (the per-user time/timezone in Settings drives what's
# shown, but not this fixed cron trigger; see README).
CRON_SECRET=""
